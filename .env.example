# =====================================================================
# Tirek environment template.
# Copy to .env and fill in values. NEVER commit real secrets.
# Production secrets live in AWS Secrets Manager, not in env files.
# =====================================================================

# --- App ---
APP_ENV=local                    # local | staging | production
APP_NAME=tirek
LOG_LEVEL=info                   # debug | info | warn | error
API_PORT=8080
API_EXTERNAL_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
# Host port for the Docker PostgreSQL container (docker-compose maps
# ${POSTGRES_PORT}:5432). Inside the Docker network the server is postgres:5432.
POSTGRES_PORT=5433
# Local dev connects as the low-privilege tirek_app role (RLS-enforced).
# The role is provisioned by infra/postgres-init/01_roles.sql in docker-compose
# or by local infra tooling; migrations run as the owner role (tirek / migrator).
DATABASE_URL=postgres://tirek_app:tirek_app@localhost:5433/tirek?sslmode=disable
DATABASE_POOL_MAX=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: openssl rand -base64 48  (must be >= 32 bytes)
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_48_bytes_min
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_48_bytes_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h                       # 30 days, rotated on use
AUTH_COOKIE_NAME=tirek_refresh
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# --- Object storage (S3) ---
S3_REGION=eu-central-1
S3_BUCKET=tirek-assets
S3_PUBLIC_BASE_URL=http://localhost:9000/tirek-assets   # localstack/minio in dev

# --- Payments (provider-agnostic, adapter per provider) ---
# Payment adapter: kaspi | stripe | mock
PAYMENT_PROVIDER=mock
PAYMENT_MODE=sandbox
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_SIGNATURE_KEY=                       # used to verify webhook HMACs
KASPI_BASE_URL=https://sandbox.kaspi.kz

# --- Financing (external regulated partners) ---
FINANCING_PROVIDER=mock                    # partner adapter: e.g. bank_bnpl | mock
FINANCING_PARTNER_API_KEY=
FINANCING_PARTNER_WEBHOOK_SECRET=

# --- Outbox / worker ---
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=100

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=CHANGE_ME_webhook_signing_secret_48_bytes_min